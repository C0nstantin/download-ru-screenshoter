{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DownloadRu Screenshoter",
  "version": "1.0.0-beta.6",
  "identifier": "com.karataev.downloadru",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "DownloadRu Screenshoter - Настройки",
        "width": 450,
        "height": 400,
        "visible": false,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' localfile: http://localfile.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' localfile: http://localfile.localhost blob:; connect-src 'self' https://download.ru; font-src 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
